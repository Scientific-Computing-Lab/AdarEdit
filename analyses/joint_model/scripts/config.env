# Portable defaults for the joint-model analysis.
# All paths are resolved from this file; no machine-specific path is required.

export ANALYSIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export REPOSITORY_ROOT="$(cd "${ANALYSIS_DIR}/../.." && pwd)"
export DATA_HUMAN="${DATA_HUMAN:-${REPOSITORY_ROOT}/data/human}"
export OUT_ROOT="${OUT_ROOT:-${ANALYSIS_DIR}/outputs/runs}"
export CACHE_ROOT="${CACHE_ROOT:-${ANALYSIS_DIR}/outputs/cache}"

export PYTHON_BIN="${PYTHON_BIN:-python}"
export EPOCHS="${EPOCHS:-1000}"
export BATCH_SIZE="${BATCH_SIZE:-256}"
export NUM_WORKERS="${NUM_WORKERS:-0}"
export NUM_THREADS="${NUM_THREADS:-8}"
export CHECKPOINT_EVERY="${CHECKPOINT_EVERY:-100}"
export SEED="${SEED:-42}"

# Space-separated variant:tissue_set entries. The default reproduces all four
# reported models. Examples:
#   RUNS="baseline:with_combined"
#   RUNS="bioaware:no_combined baseline:no_combined"
export RUNS="${RUNS:-baseline:with_combined bioaware:with_combined baseline:no_combined bioaware:no_combined}"
